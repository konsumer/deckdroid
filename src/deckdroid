#!/bin/bash
# deckdroid - run Waydroid on a Steam Deck from a directory you choose.
set -euo pipefail

. "$(dirname "$(realpath "$0")")/deckdroid-env"

DD_ROOT_HELPER=$(dirname "$(realpath "$0")")/deckdroid-root
REPO=${DECKDROID_REPO:-konsumer/deckdroid}
BUNDLE_URL=https://github.com/$REPO/releases/download/latest/deckdroid-bundle-x86_64.tar.gz

# Deliberately no "|| sudo" fallback: with one, killing a child made the parent
# immediately start another, which is why a stuck launch could not be killed.
#
# This passes the helper's exit status straight through. It must not turn every
# non-zero exit into an error of its own: wait-app returns 1 when its watchdog
# fires, and reporting that as "no password" hid the real reason a launch died.
as_root() { sudo -n "$DD_ROOT_HELPER" "$@"; }

# Check the sudoers rule once, properly, instead of inferring it from failures.
dd_require_sudo() {
  sudo -n "$DD_ROOT_HELPER" status >/dev/null 2>&1 || dd_die \
    "the root helper needs a passwordless sudo rule and does not have one.
  Re-run 'deckdroid install', or check /etc/sudoers.d/deckdroid."
}

# --- install ---------------------------------------------------------------

cmd_install() {
  local size=32G target=$DECKDROID_ROOT local_bundle=
  while [ $# -gt 0 ]; do
    case $1 in
      --root) target=$2; shift 2 ;;
      --size) size=$2; shift 2 ;;
      --bundle) local_bundle=$(realpath "$2"); shift 2 ;;
      --no-images) DECKDROID_SKIP_IMAGES=1; shift ;;
      *) dd_die "unknown option: $1" ;;
    esac
  done
  dd_require_binder

  target=$(realpath -m "$target")
  dd_info "installing to $target"
  mkdir -p "$target"

  # Persist the location so every later command and the root helper agree.
  local cfgdir=${XDG_CONFIG_HOME:-$HOME/.config}/deckdroid
  mkdir -p "$cfgdir"
  printf 'DECKDROID_ROOT=%q\n' "$target" > "$cfgdir/config"
  DECKDROID_ROOT=$target DD_BUNDLE=$target/bundle DD_IMAGE=$target/data.img

  local tmp; tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' RETURN
  if [ -n "$local_bundle" ]; then
    dd_info "using local bundle $local_bundle"
    cp "$local_bundle" "$tmp/bundle.tar.gz"
  else
    dd_info "downloading bundle"
    curl -fSL --progress-bar -o "$tmp/bundle.tar.gz" "$BUNDLE_URL" \
      || dd_die "could not download $BUNDLE_URL"
  fi
  if [ -z "$local_bundle" ] && curl -fsSL -o "$tmp/sum" "$BUNDLE_URL.sha256"; then
    ( cd "$tmp" && sed 's|  .*|  bundle.tar.gz|' sum | sha256sum -c - >/dev/null ) \
      || dd_die "bundle checksum mismatch"
    dd_info "checksum verified"
  fi
  # An older bundle may contain root-owned bytecode; fall back to the helper.
  rm -rf "$DD_BUNDLE" 2>/dev/null || as_root clean-bundle
  mkdir -p "$DD_BUNDLE"
  tar -C "$DD_BUNDLE" -xzf "$tmp/bundle.tar.gz"

  if [ ! -f "$DD_IMAGE" ]; then
    dd_info "creating $size data image (sparse, grows as used)"
    truncate -s "$size" "$DD_IMAGE"
    mkfs.ext4 -q -F -L waydroid "$DD_IMAGE"
  fi

  cmd_privileged_setup
  if [ "${DECKDROID_SKIP_IMAGES:-0}" = "1" ]; then
    dd_warn "skipping Android image download (--no-images)"
  else
    cmd_images
    dd_info "initialising waydroid"
    as_root init
  fi

  dd_info "installed. 'deckdroid start' to run it."
}

# The only two things that touch system directories. Both live in /etc, which
# survives SteamOS updates far better than /usr, and both are re-appliable.
cmd_privileged_setup() {
  local sudoers=/etc/sudoers.d/deckdroid
  local dbus=/etc/dbus-1/system.d/id.waydro.Container.conf
  dd_info "installing sudoers rule and dbus policy (needs your password once)"
  sudo install -d -m 0755 /etc/sudoers.d /etc/dbus-1/system.d
  printf '%s ALL=(root) NOPASSWD: %s\n' "$USER" "$DD_ROOT_HELPER" \
    | sudo tee "$sudoers" >/dev/null
  sudo chmod 0440 "$sudoers"
  sudo cp "$DD_BUNDLE/usr/share/dbus-1/system.d/id.waydro.Container.conf" "$dbus"
  sudo systemctl reload dbus 2>/dev/null || true
}


# --- android images -------------------------------------------------------

# waydroid downloads these itself, but with no resume and no way to retry a
# partial transfer: an interrupted download starts over from zero, which is
# painful for 1GB over SourceForge's mirrors. Fetch them here instead, against
# SourceForge's direct download host, with -C - resume and a checksum from the
# OTA manifest, then hand waydroid finished images so it skips its downloader.
ota_pick() { # channel romtype -> "url<TAB>filename<TAB>sha256<TAB>size"
  curl -fsSL "https://ota.waydro.id/$1/waydroid_x86_64/$2.json" | python3 -c '
import json, sys
newest = max(json.load(sys.stdin)["response"], key=lambda r: r["datetime"])
url = (newest["url"]
       .replace("//sourceforge.net/projects/", "//downloads.sourceforge.net/project/")
       .replace("/files/", "/")
       .removesuffix("/download"))
print("\t".join([url, newest["filename"], newest["id"], str(newest["size"])]))'
}

# SourceForge picks a mirror at random per request and they are not equal: on
# the Deck this was tested against, most sustained ~4MB/s while versaweb managed
# 0.14MB/s, which is what turned a 5-minute download into an apparent hang. So
# name mirrors explicitly, abort one that crawls, and resume onto the next --
# the partial file is kept, so switching costs nothing already downloaded.
DD_MIRRORS=${DD_MIRRORS:-phoenixnap gigenet datapacket netcologne}

fetch_one() { # url file sha256 size dest.img
  local url=$1 file=$2 sha=$3 size=$4 out=$5
  local cache=$DECKDROID_ROOT/images-cache
  mkdir -p "$cache"

  if [ ! -f "$cache/$file.ok" ]; then
    local got ok=0 m u
    for m in $DD_MIRRORS ""; do
      got=$(stat -c %s "$cache/$file" 2>/dev/null || echo 0)
      [ "$got" -ge "$size" ] && { ok=1; break; }
      u=$url; [ -n "$m" ] && u="$url?use_mirror=$m"
      dd_info "downloading $file from ${m:-sourceforge} ($(( (size - got) / 1048576 ))MB to go)"
      # Give up on a mirror delivering under 400KB/s for 30s and try the next.
      if curl -fL --progress-bar -C - --connect-timeout 20 \
           --speed-limit 400000 --speed-time 30 -o "$cache/$file" "$u"; then
        ok=1; break
      fi
      dd_warn "mirror ${m:-sourceforge} was too slow or failed; resuming elsewhere"
    done
    [ "$ok" = 1 ] || dd_die "could not download $file from any mirror"

    dd_info "verifying checksum"
    echo "$sha  $cache/$file" | sha256sum -c - >/dev/null \
      || { rm -f "$cache/$file"; dd_die "$file failed checksum; re-run to retry"; }
    touch "$cache/$file.ok"
  fi

  dd_info "extracting $(basename "$out")"
  local tmp; tmp=$(mktemp -d)
  unzip -qo "$cache/$file" -d "$tmp"
  local img; img=$(find "$tmp" -name '*.img' -print -quit)
  [ -n "$img" ] || { rm -rf "$tmp"; dd_die "no .img inside $file"; }
  mv "$img" "$out"
  rm -rf "$tmp"
}

cmd_images() {
  mkdir -p "$DECKDROID_ROOT/images"
  if [ -f "$DECKDROID_ROOT/images/system.img" ] && [ -f "$DECKDROID_ROOT/images/vendor.img" ]; then
    dd_info "android images already present"
    return 0
  fi
  local sys ven
  sys=$(ota_pick system/lineage VANILLA) || dd_die "could not reach the waydroid OTA server"
  ven=$(ota_pick vendor MAINLINE) || dd_die "could not reach the waydroid OTA server"
  # shellcheck disable=SC2086
  IFS=$'\t' read -r u f h z <<<"$sys"; fetch_one "$u" "$f" "$h" "$z" "$DECKDROID_ROOT/images/system.img"
  IFS=$'\t' read -r u f h z <<<"$ven"; fetch_one "$u" "$f" "$h" "$z" "$DECKDROID_ROOT/images/vendor.img"
  dd_info "images ready in $DECKDROID_ROOT/images"
}

# --- lifecycle -------------------------------------------------------------

session_running() { waydroid status 2>/dev/null | grep -qi 'Session:[[:space:]]*RUNNING'; }

cmd_start() {
  dd_require_binder
  dd_have_bundle || dd_die "not installed; run 'deckdroid install'"

  local display marker
  marker=$DECKDROID_ROOT/.session-display
  display=$(dd_wayland_display) || dd_die \
    "no Wayland display found in ${XDG_RUNTIME_DIR:-/run/user/$(id -u)}.
  Run this from a Deck session (Desktop or Game Mode), not a bare ssh shell."
  export WAYLAND_DISPLAY=$display
  export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

  if session_running && [ "$(cat "$marker" 2>/dev/null)" = "$display" ]; then
    dd_info "already running"
    return 0
  fi

  # A session started in Desktop Mode is bound to kwin's socket, which no longer
  # exists once you switch to Game Mode. Restart it rather than handing the app
  # a dead display.
  if session_running && [ "$(cat "$marker" 2>/dev/null)" != "$display" ]; then
    dd_info "display changed to $display; restarting session"
    waydroid session stop 2>/dev/null || true
    systemctl --user stop deckdroid-session 2>/dev/null || true
  fi

  dd_info "starting container"
  as_root container-start || dd_die "container failed to start"
  # Wait for the container manager to claim its dbus name.
  local i
  for i in $(seq 1 60); do
    waydroid status >/dev/null 2>&1 && break
    sleep 0.5
  done

  dd_info "starting session"
  # Same reasoning as the container unit: outlive the shell that started it.
  systemctl --user reset-failed deckdroid-session 2>/dev/null || true
  systemd-run --user --unit=deckdroid-session --collect --quiet \
    --description="Waydroid session (deckdroid)" \
    --setenv=PATH="$PATH" --setenv=LD_LIBRARY_PATH="$LD_LIBRARY_PATH" \
    --setenv=PYTHONPATH="$PYTHONPATH" \
    --setenv=WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
    --setenv=XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" \
    waydroid session start \
    || dd_die "could not start the session unit"

  for i in $(seq 1 120); do
    session_running && break
    sleep 0.5
  done
  session_running || dd_die "session did not come up.
  logs: journalctl --user -u deckdroid-session -n 50"

  # A running session is not a booted Android: the platform service comes up
  # seconds later, and app commands issued before then fail with
  # "Failed to get service waydroidplatform". Wait for it to answer.
  dd_info "waiting for Android to finish booting"
  for i in $(seq 1 90); do
    waydroid app list >/dev/null 2>&1 && break
    sleep 2
  done
  waydroid app list >/dev/null 2>&1 \
    || dd_warn "Android is up but its platform service is not answering yet"
  printf '%s' "$display" > "$marker" 2>/dev/null || true
  dd_info "running (display $display)"
}

cmd_stop() {
  # Clear a compositor left behind by an interrupted launch, so Steam stops
  # treating the shortcut as running. Only ever our own recorded pid.
  local stale
  stale=$(cat "$DECKDROID_ROOT/compositor.pid" 2>/dev/null || true)
  if [ -n "$stale" ] && [ "$stale" != "$$" ] && kill -0 "$stale" 2>/dev/null; then
    kill "$stale" 2>/dev/null || true
  fi
  rm -f "$DECKDROID_ROOT/compositor.pid"
  waydroid session stop 2>/dev/null || true
  systemctl --user stop deckdroid-session 2>/dev/null || true
  as_root container-stop
  dd_info "stopped"
}

cmd_status() {
  printf 'install:   %s\n' "$DECKDROID_ROOT"
  printf 'bundle:    %s\n' "$(dd_have_bundle && echo present || echo MISSING)"
  printf 'image:     %s\n' "$([ -f "$DD_IMAGE" ] && du -h --apparent-size "$DD_IMAGE" | cut -f1 || echo MISSING)"
  printf 'disk used: %s\n' "$([ -f "$DD_IMAGE" ] && du -h "$DD_IMAGE" | cut -f1 || echo -)"
  printf 'binder:    %s\n' "$(awk '$2=="binder"{f=1} END{print f?"yes":"no"}' /proc/filesystems)"
  printf 'session:   %s\n' "$(session_running && echo running || echo stopped)"
}

# --- apps ------------------------------------------------------------------

# Internal: this runs INSIDE cage, which sets WAYLAND_DISPLAY for us.
#
# The waydroid session has to be started here rather than outside, because
# Android's surfaces go to whatever display the *session* was started on. Start
# it outside and cage ends up supervising a shell script that draws nothing,
# while Android renders to the outer compositor as a window gamescope will not
# associate with the Steam shortcut -- a spinning Steam logo and no picture.
cmd_run_app() {
  local pkg=$1 i
  # The compositor's reaper runs as the user and cannot kill our root-owned
  # poller ("Failed to kill process: Operation not permitted"), so gamescope
  # would never finish tearing down and would leak an instance per launch.
  # Clear the root side ourselves on every exit path.
  trap 'as_root kill-helpers >/dev/null 2>&1 || true' EXIT INT TERM
  dd_info "session inside compositor on ${WAYLAND_DISPLAY:-unset}"
  waydroid session start >"$DECKDROID_ROOT/session.log" 2>&1 &
  for i in $(seq 1 120); do session_running && break; sleep 0.5; done
  session_running || { dd_warn "session did not start; see $DECKDROID_ROOT/session.log"; return 1; }

  for i in $(seq 1 90); do waydroid app list >/dev/null 2>&1 && break; sleep 2; done

  # multi_windows is a *persisted* Android property living in the data image,
  # so it outranks anything written to waydroid_base.prop. It also has to be
  # set as the session user: over sudo, waydroid cannot see the session at all
  # and silently reports "session is stopped".
  if [ "$(waydroid prop get persist.waydroid.multi_windows 2>/dev/null | tr -d '\r\n')" = "true" ]; then
    dd_info "disabling multi-window mode"
    waydroid prop set persist.waydroid.multi_windows false || true
  fi

  # Waydroid decides what to present from the "waydroid.active_apps" property:
  # set to a package, only that package's windows are shown; set to "Waydroid",
  # the whole Android display is. `app launch` sets the former and
  # `show-full-ui` sets the latter, so the order matters and is not obvious.
  #
  # Launching last would pin the display to one package, and anything the app
  # puts up from a *different* package -- notably the first-run permission
  # dialog, which is com.android.permissioncontroller -- would render nothing
  # at all. That is the black screen. So launch first, then widen back to the
  # full display.
  dd_info "launching $pkg"
  waydroid app launch "$pkg" || true
  sleep 3
  dd_info "attaching Android display"
  waydroid show-full-ui >>"$DECKDROID_ROOT/session.log" 2>&1 || true

  # Never block forever. If the app never gets a process, give up and exit
  # non-zero so Steam drops the "running" state instead of leaving a shortcut
  # that cannot be closed from the UI.
  if ! as_root wait-app "$pkg" --startup-timeout "${DECKDROID_STARTUP_TIMEOUT:-90}"; then
    dd_warn "$pkg never started; giving up"
    return 1
  fi
}

cmd_launch() {
  local pkg=${1:-}
  [ -n "$pkg" ] || dd_die "usage: deckdroid launch <package>"
  # Steam discards a shortcut's stdout, so a Game Mode failure would otherwise
  # be invisible. Keep a copy of everything this run prints.
  exec > >(tee -a "$DECKDROID_ROOT/launch.log") 2>&1
  echo "--- $(date -Is) launch $pkg (display=${WAYLAND_DISPLAY:-unset} gamescope=${GAMESCOPE_WAYLAND_DISPLAY:-unset})"

  dd_require_binder
  dd_have_bundle || dd_die "not installed; run 'deckdroid install'"
  dd_require_sudo

  local display
  display=$(dd_wayland_display) || dd_die \
    "no Wayland display found in ${XDG_RUNTIME_DIR:-/run/user/$(id -u)}."
  export WAYLAND_DISPLAY=$display
  export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

  # Any session started outside cage is bound to the wrong display for this.
  # The image is not mounted yet, so waydroid will say it is uninitialised;
  # that is expected here and not worth showing.
  waydroid session stop >/dev/null 2>&1 || true
  systemctl --user stop deckdroid-session >/dev/null 2>&1 || true

  dd_info "starting container"
  as_root container-start || dd_die "container failed to start"
  local i
  for i in $(seq 1 60); do waydroid status >/dev/null 2>&1 && break; sleep 0.5; done

  # Pick the compositor to run Android inside.
  #
  # In Game Mode, gamescope manages windows through Xwayland (steamcompmgr on
  # DISPLAY=:1) and never sees a pure Wayland client, so cage renders into the
  # void: Steam spins forever waiting for a window that will never be reported.
  # A nested gamescope instead presents itself as an X window steamcompmgr can
  # focus, while --expose-wayland gives Android an xdg-shell display to draw on.
  # In Desktop Mode there is no outer gamescope and cage is the lighter option.
  local -a compositor
  if [ -n "${GAMESCOPE_WAYLAND_DISPLAY:-}" ] || [ "${display#gamescope-}" != "$display" ]; then
    local geom w h
    geom=$(xdpyinfo 2>/dev/null | awk '/dimensions:/ {print $2; exit}')
    w=${geom%x*}; h=${geom#*x}
    case "${w:-}${h:-}" in ''|*[!0-9]*) w=1280; h=800 ;; esac
    export SDL_VIDEODRIVER=x11
    # Steam force-enables the Gamescope WSI Vulkan layer for anything it
    # launches. That layer assumes swapchains target the *outer* gamescope, so
    # a nested one trips "CreateSwapchainKHR: Creating swapchain for
    # non-Gamescope swapchain" and puts up a modal zenity dialog that blocks
    # rendering entirely. The layer ships its own opt-out; use it.
    export DISABLE_GAMESCOPE_WSI=1
    dd_info "game mode: nesting gamescope ${w}x${h} on DISPLAY=${DISPLAY:-unset}"
    compositor=(gamescope --backend sdl --expose-wayland -w "$w" -h "$h" --)
  else
    dd_info "desktop mode: using cage on $display"
    compositor=(cage --)
  fi

  trap 'cmd_stop; exit 0' INT TERM
  # Remember the compositor pid: if a launch is interrupted, a survivor makes
  # Steam believe the shortcut is still running and silently refuse to start it
  # again, which looks exactly like "nothing happens". Recording it also means
  # cleanup never has to guess which gamescope is ours.
  "${compositor[@]}" "$(realpath "$0")" run-app "$pkg" &
  local comp_pid=$!
  echo "$comp_pid" > "$DECKDROID_ROOT/compositor.pid"
  wait "$comp_pid" || true
  rm -f "$DECKDROID_ROOT/compositor.pid"
  if [ "${DECKDROID_KEEP_RUNNING:-0}" != "1" ]; then cmd_stop; fi
}

cmd_app() {
  cmd_start
  case "${1:-}" in
    install)
      shift
      waydroid app install "$@"
      cmd_refresh
      dd_info "run 'deckdroid shortcuts sync' to add it to Steam"
      ;;
    remove) shift; waydroid app remove "$@" ;;
    list) waydroid app list ;;
    *) dd_die "usage: deckdroid app {install <apk>|remove <pkg>|list}" ;;
  esac
}

# Tear down a stuck launch. Parents before children, because a surviving parent
# just starts the child again.
cmd_kill() {
  local pat pids p me=$$
  for pat in "deckdroid launch" "deckdroid run-app"; do
    pids=$(pgrep -f -- "$pat" 2>/dev/null || true)
    for p in $pids; do
      # never kill this process or its shell
      case " $me $PPID " in *" $p "*) continue ;; esac
      kill -9 "$p" 2>/dev/null || true
    done
    sleep 1
  done
  as_root kill-helpers || true

  # Only ever our own compositor. Never `pkill gamescope`: in Game Mode that
  # would kill the compositor running the entire Steam session. The recorded
  # pid first, then any nested instance still identifiable by the flags we
  # start it with -- the session compositor never has those.
  local ours p
  ours=$(cat "$DECKDROID_ROOT/compositor.pid" 2>/dev/null || true)
  if [ -n "$ours" ] && kill -0 "$ours" 2>/dev/null; then
    kill -9 "$ours" 2>/dev/null || true
  fi
  for p in $(pgrep -f -- "--backend sdl --expose-wayland" 2>/dev/null || true); do
    kill -9 "$p" 2>/dev/null || true
  done
  rm -f "$DECKDROID_ROOT/compositor.pid"
  cmd_stop
}

cmd_doctor() {
  printf 'kernel:    %s\n' "$(uname -r)"
  printf 'steamos:   %s\n' "$(. /etc/os-release; echo "$VERSION_ID")"
  printf 'binder:    %s\n' "$(awk '$2=="binder"{f=1} END{print f?"built in (good)":"ABSENT - waydroid cannot run"}' /proc/filesystems)"
  printf 'bundle:    %s\n' "$(dd_have_bundle && echo ok || echo missing)"
  [ -f "$DD_BUNDLE/BUNDLE-INFO" ] && sed 's/^/           /' "$DD_BUNDLE/BUNDLE-INFO"
  printf 'tools:     %s\n' "$(cat "$(dirname "$(realpath "$0")")/VERSION" 2>/dev/null || echo 'unknown (not from a release)')"
  printf 'python:    %s\n' "$(dd_python_abi)"
  printf 'sudoers:   %s\n' "$([ -f /etc/sudoers.d/deckdroid ] && echo installed || echo missing)"
  printf 'dbus:      %s\n' "$([ -f /etc/dbus-1/system.d/id.waydro.Container.conf ] && echo installed || echo missing)"
  if dd_have_bundle; then
    printf 'waydroid:  %s\n' "$(waydroid --version 2>&1 | head -1)"
  fi
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  images) cmd_images ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop; cmd_start ;;
  status) cmd_status ;;
  launch) shift; cmd_launch "$@" ;;
  run-app) shift; cmd_run_app "$@" ;;
  app) shift; cmd_app "$@" ;;
  refresh) cmd_refresh ;;
  shortcuts) shift; exec "$(dirname "$(realpath "$0")")/deckdroid-shortcuts" "$@" ;;
  kill) cmd_kill ;;
  doctor) cmd_doctor ;;
  ui) cmd_start; cage -- waydroid show-full-ui ;;
  *)
    cat <<USAGE
deckdroid - Waydroid on the Steam Deck, installed wherever you want

  install [--root DIR] [--size 32G]   download and set up
  images                              (re)fetch the Android images only
  start | stop | restart | status     manage the service
  ui                                  full Android UI
  launch <package>                    run one app, stop when it exits
  app install <apk> | remove | list   manage apps
  refresh                             regenerate app icons and desktop entries
  shortcuts sync                      add a Steam entry per installed app
  kill                                force-stop a stuck launch
  doctor                              diagnose
USAGE
    ;;
esac

#!/bin/bash
# Privileged half of deckdroid. Everything needing root lives here so the
# sudoers grant can name exactly one file.
#
# Deliberately small: mount the data image over /var/lib/waydroid, run the
# container manager, and undo both. No package installs, no rootfs writes.
set -euo pipefail

. /usr/local/lib/deckdroid/deckdroid-env 2>/dev/null \
  || . "$(dirname "$(realpath "$0")")/deckdroid-env"

[ "$(id -u)" -eq 0 ] || dd_die "deckdroid-root must run as root"
SELF=$(realpath "$0")

# /var is a 230M A/B partition on the Deck, so the Android data set cannot live
# there. It goes in an ext4 image under the user's chosen directory, loop-mounted
# onto the path waydroid hardcodes. This is also what makes the SD card work
# regardless of the filesystem the user formatted it with.
mount_work() {
  dd_mounted && return 0
  [ -f "$DD_IMAGE" ] || dd_die "no data image at $DD_IMAGE (run 'deckdroid install')"
  mkdir -p "$DD_WORK"
  local dev
  dev=$(losetup --find --show "$DD_IMAGE")
  if ! mount "$dev" "$DD_WORK"; then
    losetup -d "$dev"
    dd_die "could not mount $DD_IMAGE"
  fi
  dd_info "mounted $DD_IMAGE -> $DD_WORK"
}

umount_work() {
  dd_mounted || return 0
  umount "$DD_WORK" || dd_die "could not unmount $DD_WORK (something still using it?)"
  # Release whichever loop device backed it.
  losetup -j "$DD_IMAGE" | cut -d: -f1 | while read -r dev; do losetup -d "$dev"; done
  dd_info "unmounted $DD_WORK"
}

# waydroid only skips its own (unreliable) downloader when it finds finished
# images in one of its preinstalled paths. Ours live in the user's directory,
# which is the only place with room for them, so bind them into place.
bind_images() {
  local src=$DECKDROID_ROOT/images
  [ -f "$src/system.img" ] && [ -f "$src/vendor.img" ] || return 0
  mountpoint -q /etc/waydroid-extra/images && return 0
  mkdir -p /etc/waydroid-extra/images
  mount --bind "$src" /etc/waydroid-extra/images
}

unbind_images() {
  mountpoint -q /etc/waydroid-extra/images && umount /etc/waydroid-extra/images
  return 0
}

# waydroid writes the LXC config once, at init, and does not regenerate it on
# every start -- so patching the bundle's config_base only helps new installs.
# Repair the live config too, or lxc-start falls back to its compiled-in
# /usr/lib/lxc/rootfs, which cannot exist on a read-only rootfs.
ensure_rootfs_mount() {
  local cfg=$DD_WORK/lxc/waydroid/config
  [ -f "$cfg" ] || return 0
  grep -q '^lxc.rootfs.mount' "$cfg" && return 0
  sed -i "/^lxc.rootfs.path/a lxc.rootfs.mount = $DD_STATE/rootfs" "$cfg"
  dd_info "added lxc.rootfs.mount to the container config"
}

# Waydroid only hands the host compositor a surface per *app window* when
# multi_windows is on -- and the Android launcher is not one, so the compositor
# gets nothing to draw and shows a black screen. Take a single full-screen
# surface instead. waydroid writes [properties] into waydroid_base.prop at
# session start, so this is the setting that actually sticks.
ensure_properties() {
  local cfg=$DD_WORK/waydroid.cfg
  [ -f "$cfg" ] || return 0
  python3 -c '
import configparser, sys
path = sys.argv[1]
cfg = configparser.ConfigParser()
cfg.optionxform = str          # waydroid keys are case-sensitive
cfg.read(path)
if not cfg.has_section("properties"):
    cfg.add_section("properties")
wanted = {"persist.waydroid.multi_windows": "false"}
changed = False
for key, value in wanted.items():
    if cfg.get("properties", key, fallback=None) != value:
        cfg.set("properties", key, value)
        changed = True
if changed:
    with open(path, "w") as handle:
        cfg.write(handle)
' "$cfg"
}

# SteamOS runs firewalld, and its default "public" zone silently drops DHCP on
# the waydroid bridge: Android broadcasts DHCPDISCOVER forever and ends up with
# no address and no internet. The bridge is ours and host-local, so trust it.
ensure_firewall() {
  systemctl is-active --quiet firewalld 2>/dev/null || return 0
  firewall-cmd --zone=trusted --list-interfaces 2>/dev/null | grep -qw waydroid0 && return 0
  firewall-cmd --zone=trusted --add-interface=waydroid0 >/dev/null 2>&1 || true
  firewall-cmd --permanent --zone=trusted --add-interface=waydroid0 >/dev/null 2>&1 || true
  dd_info "added waydroid0 to the firewalld trusted zone"
}

# Android expects far more pids than SteamOS's default allows.
raise_pid_max() {
  mkdir -p "$DD_STATE"
  [ -f "$DD_STATE/pid_max" ] || sysctl -n kernel.pid_max > "$DD_STATE/pid_max"
  sysctl -q -w kernel.pid_max=200000
}

restore_pid_max() {
  [ -f "$DD_STATE/pid_max" ] || return 0
  sysctl -q -w "kernel.pid_max=$(cat "$DD_STATE/pid_max")"
  rm -f "$DD_STATE/pid_max"
}

case "${1:-}" in
  mount) mount_work ;;
  umount) umount_work ;;
  container-start)
    dd_require_binder
    mount_work
    bind_images
    # lxc.rootfs.mount in the bundled config_base points here; LXC needs the
    # directory to exist before it will start a container.
    mkdir -p "$DD_STATE/rootfs"
    ensure_rootfs_mount
    ensure_properties
    raise_pid_max
    # A transient systemd unit rather than a background process: logind tears
    # down the session scope when the launching terminal (or ssh) exits, which
    # would otherwise kill Android the moment the user closes their shell.
    systemctl is-active --quiet deckdroid-container && exit 0
    # The unit gets a minimal environment, so hand it the install location
    # explicitly rather than relying on HOME or the invoking user's config.
    ensure_firewall
    systemd-run --unit=deckdroid-container --collect --quiet \
      --description="Waydroid container (deckdroid)" \
      --setenv=DECKDROID_ROOT="$DECKDROID_ROOT" \
      "$SELF" container-run
    ;;
  container-run)
    # Internal: the body of the transient unit above.
    exec waydroid container start
    ;;
  container-stop)
    systemctl stop deckdroid-container 2>/dev/null || true
    waydroid container stop 2>/dev/null || true
    restore_pid_max
    unbind_images
    umount_work
    ;;
  firewall)
    ensure_firewall
    ;;
  init)
    shift
    dd_require_binder
    mount_work
    bind_images
    exec waydroid init "$@"
    ;;
  wait-app)
    # Block while an Android package has a live process. `waydroid shell` needs
    # root, so the whole poll loop lives here: one sudo call for the app's
    # entire lifetime rather than one per tick.
    shift
    pkg=${1:?package required}
    timeout=90
    [ "${2:-}" = "--startup-timeout" ] && timeout=${3:-90}
    started=0
    for _ in $(seq 1 "$timeout"); do
      if waydroid shell -- pidof "$pkg" >/dev/null 2>&1; then started=1; break; fi
      sleep 1
    done
    # Exit non-zero rather than blocking forever on an app that never came up.
    [ "$started" = 1 ] || exit 1
    while waydroid shell -- pidof "$pkg" >/dev/null 2>&1; do sleep 2; done
    ;;
  app-start)
    # Bring an app to the front WITHOUT touching waydroid.active_apps.
    # `waydroid app launch` sets that property to the package, which narrows
    # the display to one package and hides anything else (permission dialogs,
    # for instance).
    #
    # `am start` against the resolved component is what actually works here;
    # `monkey` exits 0 and does nothing, which is worse than failing.
    shift
    pkg=${1:?package required}
    comp=$(waydroid shell -- cmd package resolve-activity --brief \
             -c android.intent.category.LAUNCHER "$pkg" 2>/dev/null \
           | tail -1 | tr -d "\r")
    case "$comp" in
      */*) waydroid shell -- am start -n "$comp" >/dev/null 2>&1 || true ;;
      *)   waydroid shell -- monkey -p "$pkg" \
             -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 || true ;;
    esac
    exit 0
    ;;
  boot-completed)
    # Exactly "1" once Android is up. Compare the trimmed last line rather
    # than pattern-matching the whole stream, which picks up stray output.
    val=$(waydroid shell -- getprop sys.boot_completed 2>/dev/null | tr -d "\r" | tail -1)
    [ "$val" = "1" ]
    ;;
  app-foreground)
    # True when the package owns the foreground activity.
    shift
    pkg=${1:?package required}
    waydroid shell -- dumpsys activity activities 2>/dev/null \
      | grep -a "topResumedActivity" | grep -q "$pkg"
    ;;
  keymap)
    # Android maps BACK to Linux key 158 and HOME to 172 -- keys no keyboard
    # has, so Steam Input cannot send them and a TV build becomes unnavigable
    # (leanback UIs ignore the mouse by design). Overlay the key layout so
    # ordinary keys, which Steam Input *can* send, reach those actions.
    tmp=$(mktemp)
    waydroid shell -- cat /system/usr/keylayout/Generic.kl > "$tmp" 2>/dev/null
    [ -s "$tmp" ] || { rm -f "$tmp"; dd_die "could not read Generic.kl (is Android running?)"; }
    # Replace the whole line, not just a [A-Z_] run: the originals are F1/F2/F3
    # and a partial match leaves the digit behind ("HOME1"). Whole-line
    # replacement is also idempotent, so re-running keymap is safe even though
    # it reads back its own overlay.
    sed -i -e "s/^key 1[[:space:]].*/key 1     BACK/" \
           -e "s/^key 59[[:space:]].*/key 59    HOME/" \
           -e "s/^key 60[[:space:]].*/key 60    APP_SWITCH/" \
           -e "s/^key 61[[:space:]].*/key 61    MENU/" "$tmp"
    for entry in "59 HOME" "60 APP_SWITCH" "61 MENU"; do
      set -- $entry
      grep -qE "^key $1 " "$tmp" || printf "key %-5s %s\n" "$1" "$2" >> "$tmp"
    done
    dir=$DD_WORK/overlay/system/usr/keylayout
    mkdir -p "$dir"
    cp "$tmp" "$dir/Generic.kl"
    rm -f "$tmp"
    dd_info "installed key layout overlay: Esc=Back F1=Home F2=Recents F3=Menu"
    ;;
  kill-helpers)
    # Clear root-side wait loops left by an interrupted launch.
    pkill -f "deckdroid-root wait-app" 2>/dev/null || true
    exit 0
    ;;
  clean-bundle)
    # Remove a bundle that root left un-deletable files in. Scoped to the
    # configured install root so this can never be pointed at anything else.
    case "$DD_BUNDLE" in
      ""|/|/usr|/etc|/home|/var) dd_die "refusing to remove $DD_BUNDLE" ;;
      */bundle) rm -rf "$DD_BUNDLE" ;;
      *) dd_die "refusing to remove $DD_BUNDLE" ;;
    esac
    ;;
  status)
    printf 'mounted=%s\n' "$(dd_mounted && echo yes || echo no)"
    printf 'binder=%s\n' "$(awk '$2=="binder"{f=1} END{print f?"yes":"no"}' /proc/filesystems)"
    printf 'container=%s\n' "$(waydroid status 2>/dev/null | awk -F':[ \t]*' '/Session/{print $2}' || echo unknown)"
    ;;
  *) dd_die "usage: deckdroid-root {mount|umount|container-start|container-run|container-stop|wait-app|app-start|app-foreground|boot-completed|keymap|kill-helpers|clean-bundle|firewall|init|status}" ;;
esac
